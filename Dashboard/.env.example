DATABASE_URL="postgresql://rp_app:rp_app_dev@localhost:5433/rapport"
DATABASE_OWNER_URL="postgresql://postgres:postgres_dev@localhost:5433/rapport"
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Seed-användare för lokal demo (skapas av `pnpm db:seed`)
SEED_USER_EMAIL="demo@bastakompisar.se"
SEED_USER_PASSWORD="demo-losenord-123"

# E-post (valfritt). Utan nyckel hamnar mejl i .outbox/ och visas under Utskick.
RESEND_API_KEY=""
MAIL_FROM="Bästa Kompisar Rapporter <rapporter@bastakompisar.se>"
# Adress som servern/workern når appen på (för PDF-rendering). Standard: BETTER_AUTH_URL
APP_INTERNAL_URL=""

# GA4 / Google OAuth (se docs/API-GODKANNANDEN.md). Redirect-URI att registrera i Google Cloud:
#   ${BETTER_AUTH_URL}/api/connect/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Endast för lokal utveckling mot simulerad Google-server (pnpm fake-google):
# GOOGLE_AUTH_BASE="http://127.0.0.1:4010"
# GOOGLE_TOKEN_URL="http://127.0.0.1:4010/token"
# GA4_ADMIN_BASE="http://127.0.0.1:4010"
# GA4_DATA_BASE="http://127.0.0.1:4010"
SYNC_INTERVAL_HOURS="4"
SYNC_LOOKBACK_DAYS="7"

# Google Ads (samma OAuth-klient som GA4). Åtkomstnivån (Test/Explorer/Basic) följer Cloud-projektet;
# utvecklartoken behövs inte och lämnas tom (headern skickas bara om ett värde finns).
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_API_VERSION="v25"
# Meta: systemanvändar-token klistras in i appen per koppling (inte här).
# Valfri: appens hemlighet ger appsecret_proof (krävs om "Require App Secret" är på i Meta-appen).
META_APP_SECRET=""
META_API_VERSION="v23.0"
META_CONVERSION_ACTIONS="purchase,lead"
# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202609"
# TikTok
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""
# Visa demokopplingar (mockdata) på kopplingssidan
SHOW_MOCK_CONNECTORS="true"

# ── AI-analys (intern) ─────────────────────────────────────────────────────
# Nyckel från console.anthropic.com. Utan nyckel är AI-analysen avstängd.
ANTHROPIC_API_KEY=""
# Modell (standard: claude-opus-5-5)
AI_MODEL="claude-opus-5-5"
